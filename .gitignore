.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Claude Code (config/estado local da sessão, não faz parte do projeto)
.claude/

# Editores / IDEs
.vscode/
.idea/
*.swp

# Arquivos de SO
.DS_Store
Thumbs.db
desktop.ini
