# Copie este arquivo para .env e preencha os valores.
# Nunca commite o arquivo .env de verdade.

# Diretórios de dados (relativos à raiz do projeto por padrão)
DATA_DIR=./data
PROJECTS_DIR=./projects

# Banco de dados
DATABASE_URL=sqlite:///./data/app.db

# IA (Groq, usado a partir da Fase 2) — gratuito, veja console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# IA backup — usada automaticamente se a Groq falhar (chave ausente,
# limite de uso etc.). Gratuita, sem cartão, veja aistudio.google.com/apikey
# Recomendado configurar sempre: o tier gratuito da Groq caiu para 8K
# tokens/min em todos os modelos (setembro/2026), insuficiente sozinho
# para uma narração completa — o Gemini (bem mais generoso) cobre a
# lacuna automaticamente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# TTS / narração em áudio (usado a partir da Fase 3) — gratuito, sem
# chave, via vozes de nuvem do Microsoft Edge (edge-tts). Precisa de
# internet. Rode `edge-tts --list-voices` para ver outras opções de voz.
TTS_VOICE=pt-BR-AntonioNeural
TTS_RATE=-4%

# Imagens (usado a partir da Fase 4) — segundos de vídeo que cada imagem
# cobre na ferramenta de animação (Fase 5); define quantos painéis cada
# cena gera (duração da cena ÷ este valor).
VIDEO_SEGMENT_SECONDS=5.0

# Teto de imagens do projeto inteiro — quando a soma "ideal" (por duração)
# passa disso, a alocação é redistribuída proporcionalmente entre as cenas.
MAX_IMAGE_PROMPTS=50

# YouTube (usado a partir da Fase 8)
YOUTUBE_CLIENT_SECRET_FILE=
